<?xml version='1.0'?>
<sdf version='1.6'>
  <world name='maze_world'>

    <!-- Ground + Sun -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- ADD MAZE WALLS HERE -->
    <include>
      <uri>model://maze_wall</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://maze_wall</uri>
      <pose>1 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://maze_wall</uri>
      <pose>2 0 0 0 0 0</pose>
    </include>

    <!-- Add many more walls to form actual maze -->

  </world>
</sdf>

